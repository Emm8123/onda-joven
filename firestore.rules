rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuracion y contenido publico: lectura libre, escritura autenticada
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fotos: lectura publica, escritura autenticada
    match /photos/{photo} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
