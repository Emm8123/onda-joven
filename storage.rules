rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de la banda: lectura publica (CDN), escritura autenticada
    match /fotos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cualquier otra cosa: solo autenticado
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
